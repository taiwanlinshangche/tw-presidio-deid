{
  "name": "tw-presidio-deid",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "本機 Markdown 去識別化工作台，支援首次啟動與一鍵安裝",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "test": "playwright test",
    "dev:ui": "vite --host 127.0.0.1",
    "test:backend": "python3 -m unittest discover -s backend/tests -v",
    "test:live": "playwright test --config playwright.live.config.js",
    "test:setup": "node --test scripts/tests/*.test.mjs",
    "test:setup:ui": "playwright test --config playwright.setup.config.js",
    "typecheck": "tsc -p frontend --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dompurify": "3.4.15",
    "lucide-react": "^1.46.0",
    "markdown-it": "15.0.2",
    "motion": "^13.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  }
}
